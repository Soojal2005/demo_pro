generator client {
  provider     = "prisma-client"
  // Prisma 7's documented convention — generating back into
  // node_modules/@prisma/client conflicts with the package skeleton that
  // `npm install @prisma/client` puts there. Every import in this codebase
  // goes through src/prisma/client.ts rather than pointing at this path
  // directly, so it only needs to be correct in one place.
  output       = "../generated/prisma"
  // Prisma 7 defaults to ESM output; this codebase (ts-node, nest build,
  // CommonJS throughout) needs CJS or every runtime entrypoint breaks with
  // "exports is not defined in ES module scope".
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// 01 · SERVICE CATALOG
// =====================================================================

model City {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  state    String
  timezone String
  isActive Boolean @default(true)

  addresses        CustomerAddress[]
  pros             Pro[]
  platformSettings PlatformSetting[]
  areas            Area[]
  incentives       Incentive[]

  @@index([isActive])
  @@map("cities")
}

/// A city subdivision — the unit service availability is defined against.
///
/// An axis-aligned **rectangle** in lat/lng, not a circle and not a polygon.
/// The shape is the whole point: rectangles **tile**. A generated grid covers a
/// city with no gaps and no overlap, which removes the entire class of problem
/// a circle model has to manage. See CONFLICTS_AND_DECISIONS #42.
///
/// **Bounds are half-open: `min <= value < max`.** That is what makes a pin
/// landing exactly on a shared edge belong to exactly one cell instead of two
/// or none, and floating-point coordinates land on shared edges more often
/// than intuition suggests, because adjacent cells are generated from the same
/// arithmetic.
///
/// Resolution is a plain indexed range query — no trigonometry, no loading
/// every area into memory. `haversineKm` still exists for dispatch's
/// travel-time ranking; it is simply not what decides an area any more.
///
/// Deliberately not PostGIS. The whole geometry question is confined to one
/// function (`resolveArea`), so a `geography(Polygon)` column can replace this
/// later without any caller changing.
model Area {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cityId String @db.Uuid
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  name String

  /// Grid position (`A1`, `C3`) for a generated cell; null for a hand-drawn
  /// area. Survives renaming, because ops keeps talking about "cell C3" long
  /// after it has been renamed to "Vijay Nagar".
  gridRef String?

  /// generated | geocoded | manual — where `name` came from.
  ///
  /// The naming pass only ever overwrites `generated`, so a suggestion can
  /// never clobber a name a human chose. Also tells an admin at a glance which
  /// cells are still unreviewed placeholders.
  nameSource String @default("manual")

  /// Reverse-geocoded address of the cell centre. Coordinates and bounds stay
  /// authoritative; this is persisted display/audit metadata so an admin can
  /// review a zone without another provider request every time.
  addressLine        String?
  addressState       String?
  addressPostalCode  String?
  addressProvider    String?
  addressAttribution String?
  addressUpdatedAt   DateTime?

  /// Half-open on both axes: a point belongs when
  /// `minLat <= lat < maxLat AND minLng <= lng < maxLng`.
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float

  isActive Boolean @default(true)

  areaServices AreaService[]
  proAreas     ProArea[]
  bookings     Booking[]

  @@unique([cityId, name])
  @@index([cityId, isActive])
  /// What `resolveArea` reads. Latitude leads because it is the more
  /// selective of the two across a city-sized grid.
  @@index([minLat, maxLat, minLng, maxLng])
  @@map("areas")
}

/// Which services are bookable in which area.
///
/// This is the row that makes "AC repair in Vijay Nagar but not Rau"
/// expressible at all — before it, serviceability was `City.isActive` and
/// nothing finer (CONFLICTS_AND_DECISIONS #8).
///
/// Availability only. Price stays national and per-service: there are still no
/// per-area price rows, and `Booking.flatPrice` is still snapshotted from
/// `Service.flatPrice`.
model AreaService {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId    String  @db.Uuid
  area      Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  @@unique([areaId, serviceId])
  @@index([serviceId, isActive])
  @@map("area_services")
}

/// Which areas a Pro is posted to. Admin-set, like every other gate on a Pro.
///
/// A **filter on dispatch, never the ranking** — distance and travel time
/// still order the candidates. A Pro posted to Vijay Nagar may physically be
/// anywhere while travelling, and their live position is what dispatch scores;
/// this only says where they are expected to work.
model ProArea {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId  String @db.Uuid
  pro    Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)
  areaId String @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  @@unique([proId, areaId])
  @@index([areaId, isActive])
  @@map("pro_areas")
}

/// The browse tree. Field names follow ERD v10 exactly.
/// Two levels only — a category is either a root (parentCategoryId = null) or
/// the child of a root; the depth bound is a service-layer rule, not a schema
/// one. See CONFLICTS_AND_DECISIONS #10.
model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  slug      String  @unique
  iconUrl   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parentCategoryId String?           @db.Uuid
  parentCategory   ServiceCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  ServiceCategory[] @relation("CategoryTree")

  services         Service[]
  trainingModules  TrainingModule[]
  trainingSessions OfflineTrainingSession[]

  @@index([parentCategoryId, sortOrder])
  @@index([isActive])
  @@map("service_categories")
}

/// The unit of competency, of pricing and of booking. One flat national price
/// and one commission rate per service — no per-city rows, no tiers.
/// Field names follow ERD v10 exactly.
model Service {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?

  /// Feeds Dispatch slot sizing and ETA. Deliberately NOT a commission
  /// input — see CONFLICTS_AND_DECISIONS #7.
  durationMinutes Int
  /// The single customer-facing price, snapshotted onto Booking at creation
  /// (module 4). Serialises as a JSON string — CONFLICTS_AND_DECISIONS #12.
  flatPrice       Decimal @db.Decimal(12, 2)

  /// Nullable so a service can exist as a draft. Activation is gated on both
  /// being set — US-3.11: a live service with no rate leaves Pros unpaid.
  commissionType  String?
  commissionValue Decimal? @db.Decimal(12, 2)

  /// Which booking flows the customer app may offer for this service.
  supportsInstant   Boolean @default(true)
  supportsScheduled Boolean @default(true)
  supportsRecurring Boolean @default(false)

  /// Draft by default. Going live is an explicit, validated transition.
  isActive Boolean @default(false)

  /// Per-service cash gate (module 7, feature 11). Reverses
  /// CONFLICTS_AND_DECISIONS #13 — see #37 for why. Defaults to true so
  /// nothing that was bookable as cash before stops being so.
  allowsCash Boolean @default(true)

  proServices    ProService[]
  bookings       Booking[]
  recurringPlans RecurringPlan[]
  areaServices   AreaService[]

  @@index([categoryId, name])
  @@index([isActive])
  @@map("services")
}

// =====================================================================
// 02 · IDENTITY & ACCESS
// =====================================================================

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name            String  @unique
  description     String?
  permissionCodes Json    @default("[]")
  isSystemRole    Boolean @default(false)

  adminUsers AdminUser[]

  @@map("roles")
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone    String  @unique
  fullName String
  email    String  @unique

  /// Optional legacy Firebase identity. New Admins authenticate by phone OTP;
  /// existing Firebase-linked Admins remain compatible during migration.
  firebaseUid String? @unique

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// City ids this admin may act on; empty array = platform-wide.
  cityScopeJson Json @default("[]")

  pushToken          String?
  pushPlatform       String?
  pushTokenUpdatedAt DateTime?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  aadhaarDocumentVerifications ProApplication[]            @relation("AadhaarDocumentVerifier")
  panDocumentVerifications     ProApplication[]            @relation("PanDocumentVerifier")
  platformSettingsUpdated      PlatformSetting[]
  overriddenBookings           Booking[]                   @relation("BookingOverrideAdmin")
  approvedCommissionPayouts    CommissionPayout[]          @relation("PayoutApprover")
  suspendedPros                Pro[]                       @relation("ProSuspender")
  confirmedCashHandovers       CashHandover[]              @relation("CashHandoverConfirmer")
  refundedOrders               Order[]                     @relation("OrderRefundInitiator")
  reversedCommissions          BookingCommission[]         @relation("CommissionReverser")
  createdIncentives            Incentive[]                 @relation("IncentiveCreator")
  raisedPayoutDeductions       PayoutDeduction[]           @relation("DeductionRaiser")
  waivedPayoutDeductions       PayoutDeduction[]           @relation("DeductionWaiver")
  disbursedCommissionPayouts   CommissionPayout[]          @relation("PayoutDisburser")
  resolvedDiscrepancies        ReconciliationDiscrepancy[]
  hiddenReviews                Review[]                    @relation("ReviewModerator")
  markedTrainingAttendance     OfflineTrainingAttendance[] @relation("AttendanceMarker")
  adminJobs                   AdminJob[]

  @@map("admin_users")
}

// =====================================================================
// 03 · CUSTOMER PROFILE
// =====================================================================

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stable per-install id — the guest identity before a phone is attached.
  deviceId String? @unique
  /// Null while guest; becomes the auth key once verified.
  phone    String? @unique
  /// Invoice delivery only — never a login credential.
  email    String?
  fullName String?

  status     String    @default("guest")
  verifiedAt DateTime?

  /// Populated later by the Payments module on first gateway checkout.
  razorpayCustomerId String? @unique

  pushToken          String?
  pushPlatform       String?
  pushTokenUpdatedAt DateTime?

  defaultAddressId String? @db.Uuid
  isBlocked        Boolean @default(false)

  /// Exact integer counters mirroring `Pro.ratingSum` / `ratingCount`, fed by
  /// **Pro→customer** reviews only and rebuilt by the same nightly job.
  ///
  /// Read by ops and by the next Pro's job card. **Nothing automatic consumes
  /// them** — no dispatch input, no pricing input, no block. A household
  /// quietly losing service from a signal it cannot see, with no notice and no
  /// appeal, is a worse outcome than a Pro walking in forewarned. Acting on a
  /// pattern here is a human decision through `isBlocked` above.
  ratingSum   Int @default(0)
  ratingCount Int @default(0)

  addresses      CustomerAddress[]
  bookings       Booking[]
  recurringPlans RecurringPlan[]
  reviews        Review[]
  orders         Order[]
  ledgerEntries  LedgerEntry[]

  @@index([status, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String  @default("other")
  addressLine String
  landmark    String?

  /// Exact pinned coordinate — the Pro is routed to this, not the street text.
  pinLat Float
  pinLng Float

  /// GeoJSON Point, e.g. { type: 'Point', coordinates: [lng, lat] } — a
  /// convenience mirror for clients; pinLat/pinLng are what queries use.
  geoPoint Json?

  cityId String @db.Uuid
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  // NO areaId here, deliberately. It would be a cache of
  // resolveArea(pinLat, pinLng) that nothing maintains: the customers module
  // cannot reach module 13 without a dependency cycle, and booking re-resolves
  // from the pin anyway because areas get redrawn after an address is saved.
  // The app asks GET /geo/serviceability with the pin before saving, which
  // answers the same question without a column that can go stale.

  isDefault Boolean @default(false)

  bookings       Booking[]
  recurringPlans RecurringPlan[]

  @@index([customerId])
  @@index([cityId])
  @@map("customer_addresses")
}

// =====================================================================
// 04 · PRO MANAGEMENT
// =====================================================================

/// Three gates to dispatchability, all admin-set: status = approved, at
/// least one active ProService, isAvailable = true.
model Pro {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone String @unique

  /// Legal identity copied from the approved KYC application. Pro
  /// self-service endpoints never write these fields.
  fullName    String?
  dateOfBirth DateTime? @db.Date
  gender      String?

  profilePhotoUrl String?
  email           String?
  languages       Json    @default("[]")

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  /// Human-readable home-base address. Coordinates remain authoritative.
  addressLine String?

  /// Payroll identity — payroll itself is external to this system.
  employeeCode    String?   @unique
  /// Bookkeeping only — this system never pays salary, only commission.
  monthlySalary   Decimal?  @db.Decimal(12, 2)
  salaryUpdatedAt DateTime?

  status String @default("applied")

  /// Why the Pro was last suspended. Retained after reinstatement so the
  /// moderation history survives — cleared only by the next suspension.
  suspendedReason       String?
  suspendedAt           DateTime?
  suspendedByAdminId    String?    @db.Uuid
  suspendedByAdmin      AdminUser? @relation("ProSuspender", fields: [suspendedByAdminId], references: [id], onDelete: SetNull)

  approvedApplicationId String?         @unique @db.Uuid
  approvedApplication   ProApplication? @relation("ApprovedApplication", fields: [approvedApplicationId], references: [id], onDelete: SetNull)

  /// GATE: on/off duty. Set only by an admin, never by the Pro.
  isAvailable           Boolean   @default(false)
  availabilityUpdatedAt DateTime?

  pushToken          String?
  pushPlatform       String?
  pushTokenUpdatedAt DateTime?

  homeBaseLat Float?
  homeBaseLng Float?

  /// Cold fallback only — live position lives in Redis GEO (Geo & Routing).
  lastKnownLat   Float?
  lastKnownLng   Float?
  lastLocationAt DateTime?

  cityId String? @db.Uuid
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  // Exact integer counters, rebuilt nightly once Reviews/Dispatch exist.
  // Nothing in this pass writes them — declared for column shape only.
  ratingSum               Int       @default(0)
  ratingCount             Int       @default(0)
  assignmentsOffered      Int       @default(0)
  assignmentsAcknowledged Int       @default(0)
  /// Analytics only — never a ranking or pay input.
  acceptanceRate          Float?
  completedJobs           Int       @default(0)
  countersRebuiltAt       DateTime?

  /// Banknotes this Pro is currently carrying on the platform's behalf.
  ///
  /// A **cache of the ledger**, in exactly the relationship `completedJobs`
  /// has to `Booking` — module 9's nightly rebuild is what makes it
  /// authoritative. It exists as a column because dispatch gates on it
  /// (feature 16) and cannot afford a ledger aggregate per candidate.
  ///
  /// Moved by exactly two operations: a cash collection and a **confirmed**
  /// handover. Commission is never netted against it — feature 15.
  cashInHand Decimal @default(0) @db.Decimal(12, 2)

  /// Employment start date.
  approvedAt DateTime?

  /// RazorpayX contact id, created once on the first disbursement and reused
  /// forever after. Module 8 writes it; nothing reads it but the payout path.
  /// Held on the Pro rather than the bank account because a contact is the
  /// *person* in RazorpayX's model and survives them changing banks.
  razorpayxContactId String?

  applications         ProApplication[]            @relation("ProApplications")
  services             ProService[]
  bankAccounts         ProBankAccount[]
  bookings             Booking[]
  startOtpVerifiedJobs Booking[]                   @relation("BookingStartOtpVerifier")
  photoProofs          JobPhotoProof[]
  assignmentCandidates AssignmentCandidate[]
  reviews              Review[]
  commissions          BookingCommission[]
  payouts              CommissionPayout[]
  cashHandovers        CashHandover[]
  areas                ProArea[]
  incentiveProgress    ProIncentiveProgress[]
  payoutDeductions     PayoutDeduction[]
  ledgerEntries        LedgerEntry[]
  trainingProgress     ProTrainingProgress[]
  trainingAttendance   OfflineTrainingAttendance[]

  @@index([status])
  @@index([isAvailable])
  @@index([cityId])
  @@map("pros")
}

/// One row per attempt — a rejected Pro re-applying creates a new row, the
/// old one and its documents are preserved. Pro.approvedApplicationId points
/// at whichever row actually succeeded.
model ProApplication {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation("ProApplications", fields: [proId], references: [id], onDelete: Cascade)

  referredByType String  @default("none")
  referredById   String?

  submittedAt DateTime?
  queueStatus String    @default("pending")

  /// Legal identity captured from this specific KYC attempt. A rejected Pro
  /// may submit corrected values in the next application; approval copies
  /// this snapshot to Pro and locks it from Pro self-service edits.
  documentFullName    String?
  documentDateOfBirth DateTime? @db.Date
  documentGender      String?

  // Aadhaar — independently sourced and verified from PAN.
  aadhaarSource            String?
  aadhaarUrl               String?
  aadhaarNumberMasked      String?
  aadhaarStatus            String     @default("pending")
  /// Actor is explicit: type=system has no admin id; type=admin requires one.
  aadhaarVerifiedByType    String?
  aadhaarVerifiedByAdminId String?    @db.Uuid
  aadhaarVerifiedByAdmin   AdminUser? @relation("AadhaarDocumentVerifier", fields: [aadhaarVerifiedByAdminId], references: [id], onDelete: Restrict)
  aadhaarVerifiedAt        DateTime?
  aadhaarRejectionReason   String?

  // PAN — independent of aadhaarSource.
  panSource            String?
  panUrl               String?
  panNumberMasked      String?
  panStatus            String     @default("pending")
  panVerifiedByType    String?
  panVerifiedByAdminId String?    @db.Uuid
  panVerifiedByAdmin   AdminUser? @relation("PanDocumentVerifier", fields: [panVerifiedByAdminId], references: [id], onDelete: Restrict)
  panVerifiedAt        DateTime?
  panRejectionReason   String?

  reviewedByAdminId  String?
  verificationCallAt DateTime?

  decision        String?
  decisionAt      DateTime?
  rejectionReason String?

  approvedByPro Pro? @relation("ApprovedApplication")

  @@index([proId])
  @@index([queueStatus])
  @@index([aadhaarVerifiedByAdminId])
  @@index([panVerifiedByAdminId])
  @@map("pro_applications")
}

/// ProService(proId, serviceId) is the single source of truth for skill
/// matching. A Service is the unit of competency; there is no separate skill
/// code.
model ProService {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  proficiency String    @default("trainee")
  certifiedAt DateTime?
  /// Suspend one service without suspending the whole Pro.
  isActive    Boolean   @default(true)

  @@unique([proId, serviceId])
  @@index([proId])
  @@index([serviceId])
  @@map("pro_services")
}

model ProBankAccount {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)

  accountHolderName   String
  accountNumberMasked String
  ifscCode            String
  upiId               String?

  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  /// RazorpayX fund account id — the payable destination behind this row.
  ///
  /// It has to exist because `accountNumberMasked` is exactly that: masked,
  /// and a masked number cannot be paid to. Module 8 creates a **VPA** fund
  /// account from `upiId` on the first payout, because that is the one
  /// instrument stored here in full. A *bank* fund account can only be created
  /// while the unmasked number is in hand, which is module 2's verification
  /// step — this column is the seam for it. See CONFLICTS_AND_DECISIONS #51.
  razorpayxFundAccountId   String?
  /// vpa | bank_account — which rail `razorpayxFundAccountId` points at.
  razorpayxFundAccountType String?

  payouts CommissionPayout[]

  @@index([proId])
  @@map("pro_bank_accounts")
}

// =====================================================================
// 04 · BOOKING & JOB LIFECYCLE
// =====================================================================

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingNumber String          @unique
  customerId    String          @db.Uuid
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId     String          @db.Uuid
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  addressId     String          @db.Uuid
  address       CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// The area this booking was sold into, frozen at creation for the same
  /// reason `flatPrice` is: areas get redrawn, and a booking must keep saying
  /// where it was taken. Null on every booking predating areas, and on one
  /// whose pin fell outside all of them.
  areaId String? @db.Uuid
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// instant | scheduled | recurring
  bookingType String @default("instant")

  recurringPlanId String?        @db.Uuid
  recurringPlan   RecurringPlan? @relation(fields: [recurringPlanId], references: [id], onDelete: SetNull)

  rebookedFromBookingId String?   @db.Uuid
  rebookedFrom          Booking?  @relation("Rebook", fields: [rebookedFromBookingId], references: [id], onDelete: SetNull)
  rebookedInto          Booking[] @relation("Rebook")

  /// Set for every booking, including instant ones: slotEnd - slotStart is the
  /// expected duration the job was sold against, so a later edit to
  /// Service.durationMinutes cannot retroactively resize it (US-3.6).
  slotStartAt DateTime?
  slotEndAt   DateTime?

  /// Frozen at creation from Service.flatPrice. Never recomputed from the live
  /// catalogue — US-3.2, US-3.5.
  flatPrice Decimal @db.Decimal(12, 2)

  /// online | cash — FROZEN at creation. Forks the state machine: a cash
  /// booking skips awaiting_payment and has no Order row at all.
  paymentMode   String @default("cash")
  /// unpaid | authorized | paid | refunded. For cash, "paid" means a Pro is
  /// carrying banknotes — read paymentMode beside it.
  ///
  /// Written once here at creation; module 7 is its only other writer.
  paymentStatus String @default("unpaid")

  /// CASH ONLY — the store of record for a cash booking, which has no Order
  /// row (CONFLICTS_AND_DECISIONS #36). Not an input: it is `flatPrice` or it
  /// is null. A Pro cannot record a part payment.
  cashCollectedAmount Decimal?  @db.Decimal(12, 2)
  cashCollectedAt     DateTime?
  /// Set when the customer refuses to pay. The job still completes and the
  /// Pro is still paid their commission — feature 17.
  cashDeclinedAt      DateTime?
  cashDeclinedReason  String?

  status String  @default("created")
  proId  String? @db.Uuid
  pro    Pro?    @relation(fields: [proId], references: [id], onDelete: Restrict)

  assignmentAttempt Int       @default(0)
  assignedAt        DateTime?
  notifiedAt        DateTime?
  ackDeadlineAt     DateTime?
  acknowledgedAt    DateTime?
  assignmentOutcome String?

  overriddenByAdminId String?    @db.Uuid
  overriddenByAdmin   AdminUser? @relation("BookingOverrideAdmin", fields: [overriddenByAdminId], references: [id], onDelete: SetNull)
  overrideReason      String?

  arrivedAt DateTime?

  /// The trust anchor. Only a verified start code (or an audited ops
  /// force-start) may set startedAt — never the app's own claim.
  ///
  /// MINTED HERE, not by the SMS provider. The customer and the Pro are both
  /// signed in already, so this is a handshake between two authenticated
  /// parties rather than proof of who owns a phone number — it does not need
  /// to leave the system, and sending it by SMS made it impossible to show in
  /// the app, cost a message per job, and locked out any customer whose phone
  /// had no signal at the door or who had never attached a number at all.
  ///
  /// Readable by the owning customer only, and only while the booking is
  /// `arrived`. Cleared the moment it is spent, so a started job stops
  /// carrying a live code.
  startOtpCode            String?
  startOtpIssuedAt        DateTime?
  /// Legacy. Slide's reference from when the start code was an SMS. Retained
  /// so historical rows keep their audit trail; nothing writes it any more.
  startOtpProviderRef     String?
  startOtpAttempts        Int     @default(0)
  startOtpVerifiedByProId String? @db.Uuid
  startOtpVerifiedByPro   Pro?    @relation("BookingStartOtpVerifier", fields: [startOtpVerifiedByProId], references: [id], onDelete: SetNull)

  startedAt             DateTime?
  completedAt           DateTime?
  /// Computed from verified start to completion. REPORTING ONLY — commission
  /// is one flat rate per service. See CONFLICTS_AND_DECISIONS #7 and #18.
  actualDurationMinutes Int?
  /// Sampled polyline, written ONCE at completion. Never appended per ping.
  routeTrail            Json?

  /// The invoice is an artifact of the booking, not a table.
  invoiceNumber String?   @unique
  invoicePdfUrl String?
  taxAmount     Decimal?  @db.Decimal(12, 2)
  invoicedAt    DateTime?

  cancelledAt           DateTime?
  cancelReason          String?
  /// customer | ops | system. Never `pro` — a Pro cannot cancel.
  cancelledByType       String?
  cancellationFeeAmount Decimal?  @db.Decimal(12, 2)
  refundedAmount        Decimal?  @db.Decimal(12, 2)

  assignmentCandidates AssignmentCandidate[]
  statusEvents         BookingStatusEvent[]
  chatMessages         ChatMessage[]
  photoProofs          JobPhotoProof[]
  /// Up to two — one per direction. Was `Review?` back when a booking could
  /// only be reviewed by its customer.
  reviews              Review[]
  commission           BookingCommission?
  ledgerEntries        LedgerEntry[]
  /// Online only, and plural: an expired or voided order is reissued rather
  /// than mutated, so the gateway history stays readable by receipt.
  orders               Order[]

  @@index([proId, status])
  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([addressId, proId, completedAt])
  @@index([status, slotStartAt])
  // "How much work came out of Vijay Nagar this month" — the question areas
  // exist to make answerable.
  @@index([areaId, createdAt])
  @@map("bookings")
}

/// Generates future bookings on a schedule. Each occurrence is priced when it
/// is generated, not when the plan was made — CONFLICTS_AND_DECISIONS #21.
model RecurringPlan {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String          @db.Uuid
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String          @db.Uuid
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  addressId  String          @db.Uuid
  address    CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// daily | weekly | biweekly | monthly
  frequency  String
  /// [0..6], Sunday = 0. Only meaningful for weekly/biweekly.
  daysOfWeek Json   @default("[]")
  /// Wall-clock "HH:mm", interpreted in the booking city's timezone.
  timeOfDay  String

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  /// The generator's cursor: the instant the next occurrence is due.
  nextRunAt DateTime?
  isActive  Boolean   @default(true)

  bookings Booking[]

  @@index([isActive, nextRunAt])
  @@index([customerId])
  @@map("recurring_plans")
}

/// Customer ↔ assigned Pro, scoped to one booking. Neither side ever sees the
/// other's phone number. Survives completion as dispute evidence (US-4.24).
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// customer | pro. Ops reads the thread but never joins it.
  senderType    String
  senderId      String    @db.Uuid
  body          String
  attachmentUrl String?
  sentAt        DateTime  @default(now())
  readAt        DateTime?

  @@index([bookingId, sentAt])
  @@map("chat_messages")
}

/// Geo-stamped evidence, not decoration. At least one `completion` row is
/// required before a job can be completed (US-4.16).
model JobPhotoProof {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proId     String  @db.Uuid
  pro       Pro     @relation(fields: [proId], references: [id], onDelete: Restrict)

  /// before | after | completion
  photoType  String
  photoUrl   String
  lat        Float?
  lng        Float?
  capturedAt DateTime @default(now())

  @@index([bookingId, photoType])
  @@map("job_photo_proofs")
}

// =====================================================================
// 07 · PAYMENTS — RAZORPAY ORDERS AND CASH
// =====================================================================
//
// ONLINE BOOKINGS ONLY. A cash booking has no Order row at all, which means
// any report joining Order silently undercounts every cash job — the single
// most likely bug this module can cause (CONFLICTS_AND_DECISIONS #36).
//
// There is no Payment table and there will not be one. Attempt-level detail —
// every try, its failure code, the method used — lives at Razorpay and is read
// in THEIR dashboard by razorpayOrderId. Only what the platform must join or
// reconcile on is here. In exchange, there is no local copy of payment data to
// drift out of sync with the gateway.

model Order {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A booking may have several orders — expired, voided, reissued.
  bookingId  String   @db.Uuid
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// The key for every gateway lookup, support's included.
  razorpayOrderId String @unique
  /// Our reference sent to Razorpay: `<bookingNumber>-<n>`.
  receipt         String @unique

  /// Rupees, like every other money column here. Razorpay transacts in
  /// integer paise — the conversion lives in payments.money.ts and nowhere
  /// else.
  amount     Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  amountDue  Decimal @db.Decimal(12, 2)
  currency   String  @default("INR")

  /// created | attempted | paid — FORWARD ONLY. Razorpay does not guarantee
  /// webhook ordering, so a late `authorized` must not undo a `captured`.
  status String @default("created")

  /// Mirrors of the gateway for triage only. `attempts` is Razorpay's own
  /// counter and `failureCode` is the LAST failure, not a history.
  attempts    Int     @default(0)
  failureCode String?

  /// The successful attempt's reference — written once and never overwritten.
  /// A second, different payment id against a paid order is a duplicate-charge
  /// signal, not an update.
  capturedPaymentId String?   @unique
  paymentMethod     String?
  paidAt            DateTime?

  /// rzp notes echoed back: bookingId, serviceId, cityId. What makes a
  /// gateway-side row traceable to a booking without our database.
  notesJson Json?

  /// CUMULATIVE across refunds, never per-refund.
  refundAmount     Decimal?  @db.Decimal(12, 2)
  razorpayRefundId String?
  /// none | initiated | settled | failed — forward only, except that `failed`
  /// is terminal for the attempt and leaves refundAmount standing.
  refundStatus     String    @default("none")
  refundedAt       DateTime?

  refundInitiatedByAdminId String?       @db.Uuid
  refundInitiatedByAdmin   AdminUser?    @relation("OrderRefundInitiator", fields: [refundInitiatedByAdminId], references: [id], onDelete: SetNull)
  ledgerEntries            LedgerEntry[]

  @@index([bookingId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([refundStatus])
  @@map("orders")
}

/// The only thing that clears a Pro's cash balance.
///
/// Recovery is by handover, never by netting: the Pro declares, an admin
/// confirms, and only the confirmation moves `Pro.cashInHand`. Commission is
/// untouched throughout — a Pro who owes cash is still paid in full, which is
/// why a Pro who stops handing over accumulates indefinitely and no arithmetic
/// notices (CONFLICTS_AND_DECISIONS #36).
model CashHandover {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Restrict)

  /// What the Pro says they are handing over.
  declaredAmount Decimal  @db.Decimal(12, 2)
  declaredAt     DateTime @default(now())

  /// declared | confirmed | rejected
  status String @default("declared")

  /// What the admin actually counted. Deliberately allowed to differ from
  /// `declaredAmount` — the variance is the point of counting, and it is
  /// never silently reconciled away.
  confirmedAmount    Decimal?   @db.Decimal(12, 2)
  confirmedAt        DateTime?
  confirmedByAdminId String?    @db.Uuid
  confirmedByAdmin   AdminUser? @relation("CashHandoverConfirmer", fields: [confirmedByAdminId], references: [id], onDelete: SetNull)

  rejectionReason String?
  notes           String?

  @@index([proId, status])
  @@index([status, declaredAt])
  @@map("cash_handovers")
}

// =====================================================================
// 05-10 · MINIMUM SOURCE MODELS REQUIRED BY PRO LIFECYCLE & STANDING
// =====================================================================

model AssignmentCandidate {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId     String  @db.Uuid
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attemptNumber Int
  proId         String  @db.Uuid
  pro           Pro     @relation(fields: [proId], references: [id], onDelete: Restrict)
  isWinner      Boolean @default(false)

  /// The free window this Pro had, computed from committed bookings alone.
  windowStart DateTime?
  windowEnd   DateTime?

  /// Where the engine routed them from — current_location | last_job_location
  /// | home_base. Recorded so US-5.7 stays answerable after the fact.
  originType String?
  originLat  Float?
  originLng  Float?

  /// Null means excluded before scoring. US-5.11: a Pro who was never a
  /// candidate must be distinguishable from one who ranked and lost.
  rank              Int?
  distanceKm        Float?
  travelTimeMinutes Int?
  rotationScore     Float?
  durationFitScore  Float?
  /// Smoothed, not the Pro's displayed rating — a 5.0 from two reviews can
  /// legitimately lose to a 4.6 from two hundred.
  ratingScore       Float?
  offersToday       Int?
  finalRankScore    Float?

  /// unavailable | no_service | out_of_range | rotation_cooldown | already_tried
  ///
  /// `out_of_range` is **no longer produced** — the absolute travel cap was
  /// removed (CONFLICTS_AND_DECISIONS #47). Historical rows keep it, and the
  /// value stays legal so those rows still read.
  excludedReason String?

  /// How far the engine had to look to find this candidate:
  /// `area` | `neighbouring` | `city`.
  ///
  /// Widening is never silent. A booking served from outside its own area is
  /// a staffing signal, and without this column the only evidence would be
  /// that the Pro happens to live elsewhere (#46).
  searchTier String @default("area")

  evaluatedAt DateTime @default(now())

  @@unique([bookingId, attemptNumber, proId])
  @@index([proId, isWinner])
  /// Ops opens this by booking, newest attempt first — US-5.9 / US-5.11.
  @@index([bookingId, attemptNumber, rank])
  @@map("assignment_candidates")
}

model BookingStatusEvent {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  actorType String
  actorId   String

  /// Where the actor actually was at the transition — dispute and SOS
  /// evidence. Float, matching every other coordinate in this schema; see
  /// CONFLICTS_AND_DECISIONS #19.
  lat Float?
  lng Float?

  occurredAt DateTime @default(now())

  @@index([bookingId, occurredAt])
  @@index([actorType, actorId, status])
  @@map("booking_status_events")
}

/// One booking produces up to two rows, one per direction, and they are not
/// symmetric in what they mean or who may see them.
///
/// | | `reviewerType = 'customer'` | `reviewerType = 'pro'` |
/// | -- | -- | -- |
/// | Author  | the customer | the assigned Pro |
/// | Subject | the Pro | the customer |
/// | Visible | publicly, on the Pro's profile | ops and the next Pro only |
/// | Counters | `Pro.ratingSum` | `Customer.ratingSum` |
/// | Drives  | the dispatch tie-break | **nothing** |
///
/// `proId` and `customerId` are the two **participants**, not the author and
/// the subject — which direction a row is depends on `reviewerType` and
/// nothing else. Read that wrong and a Pro's rating absorbs their own opinion
/// of a customer; see CONFLICTS_AND_DECISIONS #61 for the version of this that
/// nearly shipped.
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId  String   @db.Uuid
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  proId      String   @db.Uuid
  pro        Pro      @relation(fields: [proId], references: [id], onDelete: Restrict)

  /// customer | pro — WHO WROTE IT. Defaulted so the rows that existed before
  /// the second direction did are what they always were.
  reviewerType String @default("customer")

  rating    Int
  /// Customer direction only. The Pro direction is tags, and a `comment` sent
  /// with it is a 400 rather than a silently dropped field — free text about a
  /// household, held internally and shown to strangers arriving at their door,
  /// is the one thing this design refuses.
  comment   String?
  /// A controlled vocabulary in both directions, validated in code. An
  /// unvalidated tag list is a free-text field with extra steps and cannot be
  /// aggregated into the pattern ops actually needs.
  tags      Json    @default("[]")
  /// Private S3 keys, never public URLs. Customer direction only.
  photoUrls Json    @default("[]")

  /// Moderation hides the **content**, never the score. A one-star review with
  /// an abusive sentence is still a one-star experience, and dropping the
  /// rating would let moderation quietly launder an average — as well as split
  /// the live counter from the nightly rebuild, which counts rows.
  isHidden        Boolean    @default(false)
  hiddenReason    String?
  hiddenByAdminId String?    @db.Uuid
  hiddenByAdmin   AdminUser? @relation("ReviewModerator", fields: [hiddenByAdminId], references: [id], onDelete: SetNull)
  hiddenAt        DateTime?

  /// Was `bookingId @unique`, which allowed exactly one row per booking and so
  /// made the second direction impossible to write at all.
  @@unique([bookingId, reviewerType])
  @@index([proId, reviewerType, createdAt])
  /// The customer advisory query — every Pro-authored row about one household.
  @@index([customerId, reviewerType, createdAt])
  @@index([hiddenByAdminId])
  @@map("reviews")
}

model BookingCommission {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  proId     String  @db.Uuid
  pro       Pro     @relation(fields: [proId], references: [id], onDelete: Restrict)

  customerFlatAmount    Decimal @db.Decimal(12, 2)
  /// Recorded because the ERD asks for it, and **never read by the
  /// calculation**. One flat rate per service: a four-hour job pays exactly
  /// what a one-hour one does (CONFLICTS_AND_DECISIONS #18). There is a spec
  /// that asserts changing this changes no amount.
  actualDurationMinutes Int?
  /// SNAPSHOT of `Service.commissionType` / `commissionValue` at computation.
  /// This pair is why editing a service tomorrow cannot restate what was paid
  /// yesterday (US-8.3) — the live catalogue row is never re-read.
  commissionType        String
  commissionValue       Decimal @db.Decimal(12, 2)
  /// What the **Pro earns**, not what the platform takes. `netPayable` is
  /// built from it, which is what settles the direction — see
  /// CONFLICTS_AND_DECISIONS #52.
  commissionAmount      Decimal @db.Decimal(12, 2)
  /// `customerFlatAmount - commissionAmount`, always. Never computed
  /// independently, so the two provably sum to the price.
  platformAmount        Decimal @db.Decimal(12, 2)

  incentiveAmount Decimal  @default(0) @db.Decimal(12, 2)
  deductionAmount Decimal  @default(0) @db.Decimal(12, 2)
  netPayable      Decimal  @db.Decimal(12, 2)
  /// pending | approved | paid | reversed
  status          String   @default("pending")
  computedAt      DateTime @default(now())

  /// Set when the hold window elapses with no dispute. Only `approved` rows
  /// are ever swept into a payout (US-8.9).
  approvedAt DateTime?

  /// A reversed row keeps whatever status it reached. If it was already
  /// `paid`, it **stays** paid — it was — and the recovery becomes a
  /// `PayoutDeduction` instead. Nothing is ever debited from a bank account.
  reversedAt        DateTime?
  reversalReason    String?
  reversedByAdminId String?    @db.Uuid
  reversedByAdmin   AdminUser? @relation("CommissionReverser", fields: [reversedByAdminId], references: [id], onDelete: SetNull)

  payoutId String?           @db.Uuid
  payout   CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  incentiveContributions ProIncentiveContribution[]
  creditedIncentives     ProIncentiveProgress[]
  deductions             PayoutDeduction[]

  @@index([proId, computedAt])
  @@index([payoutId])
  /// The batching query: approved, unpaid, oldest first.
  @@index([status, proId, computedAt])
  @@map("booking_commissions")
}

model CommissionPayout {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId         String         @db.Uuid
  pro           Pro            @relation(fields: [proId], references: [id], onDelete: Restrict)
  bankAccountId String         @db.Uuid
  bankAccount   ProBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  /// The period this batch is *labelled* with. It is not the inclusion filter:
  /// a commission approved late (held behind a dispute) would otherwise be
  /// orphaned by every later batch. Inclusion is "approved and unpaid as of
  /// periodEnd" — see `payout-batch.service.ts`.
  periodStart       DateTime   @db.Date
  periodEnd         DateTime   @db.Date
  commissionAmount  Decimal    @db.Decimal(12, 2)
  incentiveAmount   Decimal    @default(0) @db.Decimal(12, 2)
  deductionAmount   Decimal    @default(0) @db.Decimal(12, 2)
  netAmount         Decimal    @db.Decimal(12, 2)
  /// draft | approved | processing | paid | failed | rejected
  status            String     @default("draft")
  approvedByAdminId String?    @db.Uuid
  approvedByAdmin   AdminUser? @relation("PayoutApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  paidAt            DateTime?
  payoutReference   String?

  /// Who pressed send. Separate from the approver on purpose: `payout.approve`
  /// and `payout.disburse` are different grants, and storing both is what
  /// makes the two-person control auditable rather than merely intended.
  disbursedByAdminId String?    @db.Uuid
  disbursedByAdmin   AdminUser? @relation("PayoutDisburser", fields: [disbursedByAdminId], references: [id], onDelete: SetNull)
  disbursedAt        DateTime?

  /// Sent to RazorpayX as `X-Payout-Idempotency`. Unique here as well as
  /// there, so a double-submit cannot become a double payment even if the
  /// request never reaches them. A retry mints a **new** key — deliberately,
  /// because reusing one would make RazorpayX replay the original response
  /// rather than attempt the transfer again.
  idempotencyKey String? @unique
  /// vpa | bank_account
  payoutMode     String?
  attemptCount   Int     @default(0)
  /// Why the last attempt failed, in RazorpayX's words. Shown to finance,
  /// never to the Pro — they see "payment failed", which is the true part.
  failureReason  String?

  commissions BookingCommission[]
  deductions  PayoutDeduction[]

  ledgerEntries LedgerEntry[]

  @@index([proId, periodEnd])
  @@index([status, periodEnd])
  @@map("commission_payouts")
}

/// A bonus scheme. Criteria live in JSON because the four types ask entirely
/// different questions; the shape is validated per type at write time, so a
/// malformed scheme is rejected at creation rather than discovered at payout.
model Incentive {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?

  /// jobs_count | rating | streak | surge_slot
  ///
  /// Only the first two have evaluators. The other two are accepted so a
  /// scheme can be configured, and every read surfaces `hasEvaluator: false`
  /// for them — the failure a Pro must never hit is a bonus advertised in the
  /// app that silently never pays (see 3.6 of the module plan).
  incentiveType String

  /// once | daily | weekly | monthly
  ///
  /// "Complete 20 jobs → ₹2,000" is a different promise depending on whether
  /// it can be won again next month. Progress is keyed by the period this
  /// yields, so a recurring scheme genuinely restarts instead of being
  /// permanently locked by a single unique row.
  recurrence String @default("once")

  criteriaJson Json
  rewardAmount Decimal @db.Decimal(12, 2)

  /// Null = every city.
  cityId String? @db.Uuid
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  validFrom DateTime
  validTo   DateTime?
  isActive  Boolean   @default(true)

  createdByAdminId String?    @db.Uuid
  createdByAdmin   AdminUser? @relation("IncentiveCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  progress ProIncentiveProgress[]

  @@index([isActive, validFrom, validTo])
  @@index([cityId, isActive])
  @@map("incentives")
}

/// One Pro's run at one incentive, in one period.
model ProIncentiveProgress {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId       String    @db.Uuid
  pro         Pro       @relation(fields: [proId], references: [id], onDelete: Cascade)
  incentiveId String    @db.Uuid
  incentive   Incentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)

  /// `lifetime`, `2026-08`, `2026-W33` or `2026-08-12`, derived from
  /// `Incentive.recurrence`. Part of the unique key, which is what lets a
  /// monthly scheme be won again in September.
  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  /// Derived: the sum of non-reversed `ProIncentiveContribution.value`.
  /// Stored so the Pro app can render a progress bar without an aggregate per
  /// row, and recomputed from the contributions whenever one is unwound.
  progressValue Decimal @default(0) @db.Decimal(12, 2)
  targetValue   Decimal @db.Decimal(12, 2)

  achievedAt     DateTime?
  rewardCredited Boolean   @default(false)
  /// SNAPSHOT of `Incentive.rewardAmount` at the moment it was credited, for
  /// the same reason the commission rate is snapshotted: editing the scheme
  /// must not restate a bonus already earned.
  rewardAmount   Decimal?  @db.Decimal(12, 2)

  /// The job the reward was credited against. A reversal of that job follows
  /// this back to unwind the bonus (US-8.7's edge).
  commissionId String?            @db.Uuid
  commission   BookingCommission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  contributions ProIncentiveContribution[]

  @@unique([proId, incentiveId, periodKey])
  @@index([proId, achievedAt])
  @@map("pro_incentive_progress")
}

/// Which job contributed how much toward which incentive run.
///
/// Progress used to be a bare number with a single `commissionId` pointing at
/// whichever job happened to tip it over. That records the *trigger* and
/// forgets the other forty-nine jobs, so a reversal of any of them had nothing
/// to follow and the progress silently kept a job it no longer had. These rows
/// are the real history: progress is their sum, and unwinding one is a delete
/// plus a recount rather than a guess.
model ProIncentiveContribution {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  progressId String               @db.Uuid
  progress   ProIncentiveProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  commissionId String            @db.Uuid
  commission   BookingCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  /// 1 for a job-count scheme; the rating given, for a rating scheme.
  value Decimal @db.Decimal(12, 2)

  /// One contribution per job per incentive run. The guard against a retried
  /// completion counting the same job twice toward the same bonus.
  @@unique([progressId, commissionId])
  @@index([commissionId])
  @@map("pro_incentive_contributions")
}

/// Money owed back to the platform, carried forward to the next payout.
///
/// A ROW, not a running total on the Pro. A scalar could not say what the
/// money was for, would double-apply on a retry, and would be unauditable —
/// and this is the mechanism that exists specifically so nothing is ever
/// debited from a Pro's bank account (US-8.14).
model PayoutDeduction {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Restrict)

  amount         Decimal @db.Decimal(12, 2)
  /// Consumption is **partial** by design. A deduction larger than a period's
  /// earnings takes what it can and waits for the rest, so a payout is never
  /// negative and the debt is never silently written off.
  consumedAmount Decimal @default(0) @db.Decimal(12, 2)

  /// commission_reversal | incentive_unwind | manual
  kind   String
  reason String

  sourceCommissionId String?            @db.Uuid
  sourceCommission   BookingCommission? @relation(fields: [sourceCommissionId], references: [id], onDelete: SetNull)

  /// Exactly-once key for the automatic kinds — `reversal:<commissionId>`,
  /// `incentive_unwind:<progressId>`. Null for a manual deduction, because
  /// Postgres treats NULLs as distinct and ops may legitimately raise two
  /// against the same job. This single unique column is what makes "the same
  /// reversal cannot deduct twice" a database guarantee rather than a hope.
  dedupeKey String? @unique

  consumedByPayoutId String?           @db.Uuid
  consumedByPayout   CommissionPayout? @relation(fields: [consumedByPayoutId], references: [id], onDelete: SetNull)
  fullyConsumedAt    DateTime?

  waivedAt        DateTime?
  waiveReason     String?
  waivedByAdminId String?    @db.Uuid
  waivedByAdmin   AdminUser? @relation("DeductionWaiver", fields: [waivedByAdminId], references: [id], onDelete: SetNull)

  raisedByAdminId String?    @db.Uuid
  raisedByAdmin   AdminUser? @relation("DeductionRaiser", fields: [raisedByAdminId], references: [id], onDelete: SetNull)

  /// The outstanding-debt query: this Pro, not waived, not fully consumed.
  /// Named, because what it is *for* is not obvious from its three columns.
  @@index([proId, fullyConsumedAt, waivedAt], map: "payout_deductions_proId_outstanding_idx")
  @@map("payout_deductions")
}

// =====================================================================
// 08 · TRAINING
// =====================================================================
//
// There is no enrolment table for online modules and no per-Pro assignment
// list. What a Pro must study is a QUERY:
//
//   Pro → ProService (isActive) → Service → categoryId → walk ancestors
//       → TrainingModule for that set of categories
//
// So adding a service to a Pro changes their curriculum in the same instant,
// and there is no second copy of the answer to drift. The ancestor walk is
// what makes "trade-level" mean anything in a category tree: a module attached
// to Plumbing reaches every Pro who does any plumbing service, and one
// attached to Drainage reaches only those.

model TrainingModule {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title       String
  description String?

  /// video | doc | checklist | quiz
  contentType  String
  /// Private S3 key for platform-uploaded content. Read through a presigned
  /// GET like every other private object here — but with a six-hour TTL, not
  /// the five minutes a KYC document gets. A 48 MB video on Indian mobile data
  /// does not finish downloading in five minutes.
  contentKey   String?
  /// Absolute URL for content hosted somewhere else. Exactly one of
  /// `contentKey` / `contentUrl` is set, enforced by a CHECK.
  contentUrl   String?
  /// Object size. The app cannot honour "download on wifi only" without it.
  contentBytes Int?

  /// Bumped whenever the content behind a module is replaced.
  ///
  /// The one correctness-critical field in the offline manifest: without it,
  /// swapping a video leaves every Pro who already downloaded the old one
  /// watching last month's procedure, with nothing to tell them or their app.
  version Int @default(1)

  /// The answer key. **Never serialised to a Pro** — there is a spec that
  /// walks the Pro-facing DTO and fails if this key appears anywhere in it.
  /// Grading happens on the server because a score the Pro's own phone
  /// computed is not the defensible signal the feature asks for.
  ///
  /// Shape: `{ "<questionId>": "b" }` or `{ "<questionId>": ["a","c"] }`.
  quizAnswerKey   Json?
  /// Per-module override of `training.quizPassPercent`.
  quizPassPercent Int?

  /// Gates `ProService.isActive` — but only where `training.gateActivation` is
  /// on, which it is not by default. See TrainingGatePort.
  isMandatory Boolean @default(false)

  durationMinutes Int?
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  progress ProTrainingProgress[]

  @@index([categoryId, sortOrder])
  @@index([isActive])
  @@map("training_modules")
}

model ProTrainingProgress {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId    String         @db.Uuid
  pro      Pro            @relation(fields: [proId], references: [id], onDelete: Cascade)
  moduleId String         @db.Uuid
  module   TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  /// not_started | in_progress | completed
  status              String @default("not_started")
  percentComplete     Int    @default(0)
  /// Where to resume. An interrupted forty-minute video that restarts from
  /// zero is a video nobody finishes twice.
  lastPositionSeconds Int    @default(0)

  quizAttempts  Int       @default(0)
  /// The most recent attempt — what to show.
  quizScore     Decimal?  @db.Decimal(5, 2)
  /// The best attempt — what the gate reads, so a curious retake cannot
  /// un-qualify someone who already passed.
  bestQuizScore Decimal?  @db.Decimal(5, 2)
  /// Attempts exhausted. Cleared by an admin; a cap with no reset path is a
  /// Pro permanently unable to work.
  lockedAt      DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  @@unique([proId, moduleId])
  @@index([proId, status])
  @@index([moduleId])
  @@map("pro_training_progress")
}

/// Client-run classroom and field training. Scheduling, enrolment and
/// attendance are all admin actions — a Pro reads their own sessions and
/// nothing else.
model OfflineTrainingSession {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title           String
  venue           String
  scheduledAt     DateTime
  durationMinutes Int?
  trainerName     String?
  capacity        Int

  /// scheduled | held | cancelled
  status String @default("scheduled")

  attendance OfflineTrainingAttendance[]

  @@index([status, scheduledAt])
  @@index([categoryId, scheduledAt])
  @@map("offline_training_sessions")
}

model OfflineTrainingAttendance {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String                 @db.Uuid
  session   OfflineTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proId     String                 @db.Uuid
  pro       Pro                    @relation(fields: [proId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  attended        Boolean    @default(false)
  markedByAdminId String?    @db.Uuid
  markedByAdmin   AdminUser? @relation("AttendanceMarker", fields: [markedByAdminId], references: [id], onDelete: SetNull)
  markedAt        DateTime?
  completionNotes String?

  /// Enrolling the same Pro twice is a bug, not a second seat — and capacity
  /// is counted from these rows.
  @@unique([sessionId, proId])
  @@index([proId])
  @@index([markedByAdminId])
  @@map("offline_training_attendance")
}

// =====================================================================
// 09 · LEDGER & RECONCILIATION
// =====================================================================

/// The books. Append-only: there is a trigger on this table that raises on
/// UPDATE and DELETE, so immutability is a property of the database rather
/// than a rule somebody has to remember.
///
/// **One row, two legs.** `debitAccount` and `creditAccount` both live here, as
/// the ERD models it, which makes every row balanced by construction — there is
/// no way to write half an entry. An account's balance is
/// `sum(credits) - sum(debits)` over this table.
model LedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  /// Gap-free, assigned under the same advisory lock that reads `prevHash`.
  /// Deliberately not a Postgres sequence: `nextval` is non-transactional, so a
  /// rolled-back insert would leave a hole, and a hole in a hash chain is
  /// indistinguishable from a deletion.
  sequence  BigInt   @unique
  entryDate DateTime

  /// charge | refund | platform_revenue | pro_commission | deduction | incentive
  ///
  /// `platform_revenue` is in the vocabulary because the ERD names it, and
  /// nothing writes it: the platform's share is `revenue:bookings` less
  /// `expense:pro_commission`, and a stored copy would be a second figure to
  /// drift. The dashboard computes it.
  txnType       String
  debitAccount  String
  creditAccount String
  amount        Decimal @db.Decimal(12, 2)
  currency      String  @default("INR")

  bookingId  String?           @db.Uuid
  booking    Booking?          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  /// Null for cash bookings — they have no `Order` row at all.
  orderId    String?           @db.Uuid
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payoutId   String?           @db.Uuid
  payout     CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  proId      String?           @db.Uuid
  pro        Pro?              @relation(fields: [proId], references: [id], onDelete: Restrict)
  customerId String?           @db.Uuid
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// A gateway reference, not a local foreign key.
  razorpayPaymentId String?

  /// Exactly-once key — `capture:<orderId>`, `accrual:<commissionId>`. Same
  /// mechanism as `PayoutDeduction.dedupeKey`: a retried webhook or a re-run
  /// sweeper must not append a second entry for one event, and a unique index
  /// is the only version of that guarantee which survives a race.
  sourceRef String @unique

  prevHash  String
  entryHash String @unique

  @@index([entryDate])
  @@index([debitAccount, entryDate])
  @@index([creditAccount, entryDate])
  @@index([proId, entryDate])
  @@map("ledger_entries")
}

/// One execution of the nightly cross-check.
///
/// The reconciliation *answer* was always recomputable from `Order`, `Booking`
/// and `CashHandover`; what module 7 could not record was the history of having
/// asked. This is that row.
model ReconciliationRun {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  runDate DateTime @db.Date
  /// money | cash | ledger | both | all
  scope   String

  startedAt     DateTime
  completedAt   DateTime?
  /// running | completed | failed
  status        String    @default("running")
  /// Set when `status = failed`, so a run that died is distinguishable from a
  /// run that found nothing.
  failureReason String?

  entriesScanned      Int     @default(0)
  bookingsScanned     Int     @default(0)
  ordersScanned       Int     @default(0)
  countersRebuilt     Boolean @default(false)
  discrepancyCount    Int     @default(0)
  totalVarianceAmount Decimal @default(0) @db.Decimal(12, 2)

  discrepancies ReconciliationDiscrepancy[]

  @@index([runDate])
  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

/// A question for a human. **Nothing here is auto-corrected** — silently making
/// our row match the gateway's would destroy the only evidence that they ever
/// differed.
model ReconciliationDiscrepancy {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runId String            @db.Uuid
  run   ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// The six kinds module 7 already detects, plus the four this module adds:
  /// missing_ledger_entry | ledger_amount_mismatch | orphan_ledger_entry |
  /// chain_broken
  kind      String
  /// A razorpayOrderId, a bookingNumber, a proId or a ledger sequence, by kind.
  reference String
  ours      String?
  theirs    String?
  variance  String?
  detail    String

  resolvedAt        DateTime?
  resolutionNotes   String?
  resolvedByAdminId String?    @db.Uuid
  resolvedByAdmin   AdminUser? @relation(fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  /// The open-work query, and the reason a repeat of the same finding on the
  /// next run does not bury yesterday's unresolved one.
  @@index([resolvedAt, kind])
  @@index([runId])
  @@map("reconciliation_discrepancies")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key              String
  cityId           String?    @db.Uuid
  city             City?      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  value            String
  description      String?
  updatedByAdminId String?    @db.Uuid
  updatedByAdmin   AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([key, cityId])
  @@index([cityId, key])
  @@map("platform_settings")
}

/// Durable work submitted from the admin console. Bulk updates and report
/// exports are intentionally asynchronous so an HTTP timeout cannot leave ops
/// guessing whether half a city was changed.
model AdminJob {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  /// bulk_update | report_export
  jobType     String
  /// pros | pro_services | commission | operational | retention | city_performance
  targetEntity String
  filterJson   Json
  changesJson  Json?
  /// csv | xlsx | pdf; null for bulk updates
  format       String?

  /// queued | running | completed | partial | failed
  status         String @default("queued")
  totalCount     Int    @default(0)
  processedCount Int    @default(0)
  succeededCount Int    @default(0)
  failedCount    Int    @default(0)

  /// Private S3 object key. A fresh short-lived URL is generated per download.
  resultFileKey String?
  failureReason String?
  requesterIp   String?
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([adminUserId, createdAt])
  @@index([status, createdAt])
  @@map("admin_jobs")
}
