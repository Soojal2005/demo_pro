# ---------------------------------------------------------------------------
# Template of every variable the app reads. THIS is the file that gets
# committed — .env, .env.local and .env.production are gitignored.
# Copy it to get started:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# local | production
NODE_ENV=local

APP_NAME=homingo-backend
API_PREFIX=api
API_VERSION=v1

PORT=3000
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# comma-separated origins, or * for all
CORS_ORIGIN=*

# --- AWS RDS (PostgreSQL), via Prisma -------------------------------------
# !! THIS FILE IS COMMITTED TO GIT. Never put real credentials here. !!
# Put real values in .env.local / .env.production, which are ignored.
#
# Prisma (both the CLI — migrate/seed/studio, via prisma.config.ts — and
# PrismaService's driver adapter at runtime) reads this one variable only.
# Percent-encode any @ : / ? # in the password, e.g. a "#" must be "%23".
# uselibpqcompat=true&sslmode=require: encrypts without verifying the RDS
# CA — newer pg-connection-string versions made plain sslmode=require mean
# full verification, so this pair restores the old libpq-style "encrypt,
# don't verify" behavior.
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&uselibpqcompat=true
DATABASE_URL=

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
# Leave OTP_PROVIDER unset to select Slide automatically when both Slide
# credentials exist; otherwise local/test uses the mock. Production requires
# Slide and refuses to boot with the mock provider.
OTP_PROVIDER=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_WINDOW_SECONDS=300
OTP_VERIFY_LOCKOUT_SECONDS=900
GUEST_RETENTION_DAYS=30
GUEST_PURGE_INTERVAL_SECONDS=86400

# OpenStreetMap Nominatim reverse geocoding. The public service requires an
# identifying User-Agent with a real contact and application-wide caching.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
NOMINATIM_ACCEPT_LANGUAGE=en
NOMINATIM_TIMEOUT_MS=4000
NOMINATIM_CACHE_TTL_SECONDS=2592000
SLIDE_WIDGET_ID=
SLIDE_API_KEY=
# Initial otp.send uses the channel configured on the Slide widget. This
# value is reserved for a future explicit retry-channel endpoint.
SLIDE_DEFAULT_CHANNEL=

# --- Redis --------------------------------------------------------------
# Sessions (refresh-token revocation), OTP rate-limiting and the local OTP
# mock all live here — see docs/Modules_and_Features's "live state" rule:
# none of this is a Postgres table. REDIS_URL overrides the discrete
# REDIS_* fields below when set, same precedence as DATABASE_URL.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

AWS -->>
# --- AWS S3 (KYC documents) -------------------------------------------------
# Bucket is private; access is via presigned URLs only. Leave the access-key
# fields blank once this runs on EC2 with the IAM role attached — the SDK
# picks that up automatically. Filled in here only for local testing.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Firebase Authentication (admin login: password + Google) -------------
# Service-account JSON downloaded from Firebase Console -> Project Settings
# -> Service Accounts -> Generate new private key. As sensitive as a DB
# password — keep it under /secrets (gitignored), never commit the file.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-admin-sdk.json

# --- Razorpay (online payments only) --------------------------------------
# Unlike every other block in this file, ALL THREE may be left blank: cash is
# the default payment mode, has no gateway, and runs the whole booking
# lifecycle without them. With none set, the app boots, logs a warning, and
# online bookings return "payments are not available" — which is true.
#
# What is NOT allowed is setting some of them. Half-configured is worse than
# unconfigured: order creation would work and webhook verification would
# reject every delivery, leaving paid bookings stuck in awaiting_payment with
# the customer's money taken. The config refuses to start in that state.
#
# RAZORPAY_KEY_SECRET signs the checkout handoff; RAZORPAY_WEBHOOK_SECRET is a
# DIFFERENT secret, set separately in the Razorpay dashboard, that signs
# webhook deliveries. Using one for the other fails silently as "every
# delivery rejected".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Override only to point at a mock gateway in tests.
RAZORPAY_BASE_URL=

# --- RazorpayX (module 8 · payouts to Pros) --------------------------------
# A DIFFERENT PRODUCT from Razorpay above. Different dashboard, different
# credentials, different direction: Razorpay pulls money in from customers,
# RazorpayX pushes it out from a current account. The keys are not
# interchangeable, and using one for the other fails as an auth error that
# reads like an outage.
#
# All four together, or none. Leave them blank and the whole module still
# works — commissions compute, incentives credit, batches generate, finance
# approves — and only the transfer reports, honestly, that it cannot happen.
#
# RAZORPAYX_ACCOUNT_NUMBER is the current account money leaves from. It is not
# derivable from the key, and RazorpayX refuses a payout without it.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Override only to point at a mock gateway in tests.
RAZORPAYX_BASE_URL=

# Set to `false` to stop the periodic commission pass (sweeper, hold-window
# approvals, late rating incentives). Every one of them is also an admin
# endpoint, so turning this off does not make them unreachable.
COMMISSION_WORKER_ENABLED=

# --- Ledger (module 9) -----------------------------------------------------
# Set to `false` to stop the nightly reconciliation at 02:30 IST. That pass
# also rebuilds the derived Pro counters, so turning it off stops drift
# self-healing. POST /admin/reconciliation/run does the same work on demand.
RECONCILIATION_ENABLED=

# --- API docs -------------------------------------------------------------
# Swagger is ON by default outside production and OFF inside it (an open
# schema advertises every route and field). Set explicitly to override.
SWAGGER_ENABLED=
SWAGGER_PATH=docs

# --- Geocoding ----------------------------------------------------------
# Turning a pin into a human-readable address.
#
# Provider is chosen by PRESENCE: set GOOGLE_MAPS_API_KEY and Google answers;
# leave it blank and OpenStreetMap Nominatim does, free. GEOCODER_PROVIDER
# overrides, and refuses to start if it names google without a key rather than
# silently using the other one.
#
# Beyond accuracy, the key removes a throughput limit: Nominatim's public
# policy is ONE request per second for the whole application, so naming a
# 36-cell grid takes over half a minute. Google has no politeness interval and
# the same pass finishes in seconds.
#
# This is a SERVER-side key — restrict it by IP in the Google console, not by
# HTTP referrer. A referrer restriction does nothing for a backend caller.
GEOCODER_PROVIDER=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_TIMEOUT_MS=5000
GOOGLE_MAPS_CACHE_TTL_SECONDS=2592000

# --- Routing / ETA --------------------------------------------------------
# The Routes API is a DIFFERENT product from Geocoding and a different host
# (routes.googleapis.com). It must be enabled separately in the Google console
# — a key that geocodes happily returns PERMISSION_DENIED here until it is.
#
# It also replaces the legacy Distance Matrix and Directions APIs, which
# projects created since 2025 cannot enable at all.
#
# By default the key above serves both. Set GOOGLE_ROUTES_API_KEY only to put
# routing on a separate key with its own quota and its own bill.
#
# With no key: dispatch still ranks candidates correctly from straight-line
# distance, and no customer-facing ETA is published — `etaMinutes` stays null
# rather than showing a guess as an arrival time.
ROUTING_PROVIDER=
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=
ROUTING_TIMEOUT_MS=4000
# Short on purpose. An address at a pin never changes; traffic on a road
# changes constantly.
ROUTING_CACHE_TTL_SECONDS=60
# Decimal places an origin is rounded to for the cache key. 3 is about 110 m —
# a Pro who has moved less than a block reuses the last answer, which is what
# keeps a GPS ping every few seconds from being a billed call every few
# seconds.
ROUTING_ORIGIN_PRECISION=3

# --- CloudFront / server-driven UI ----------------------------------------
# Required for publishing Module 14 UI trees. The S3 bucket remains private;
# CloudFront reads it through Origin Access Control. UI publication fails
# closed when domain/distribution are absent.
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
# Optional signing pair for authenticated training content. Store the PEM as
# base64 so multiline secrets survive dotenv and deployment secret stores.
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_BASE64=

# --- Notifications (module 12) --------------------------------------------
# `mock` records accepted provider references without contacting third
# parties. Production should use `live` only after every required credential
# below is present and provider sandbox checks pass.
NOTIFICATION_PROVIDER_MODE=mock
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=1000

# Android uses FCM. iOS messages use the APNs payload supported by FCM, which
# requires APNs credentials to be configured in the Firebase project.
# FIREBASE_SERVICE_ACCOUNT_PATH above is reused.

# Full Meta Graph messages endpoint, including API version and phone-number id,
# e.g. https://graph.facebook.com/<version>/<phone-number-id>/messages
WHATSAPP_GRAPH_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Vendor adapter contract: POST JSON { to, message, clientReference } with a
# bearer API key. Change only NotificationProviderService for a vendor whose
# request shape differs.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_WEBHOOK_SECRET=
